# Environment Variables Configuration
# Sao chép file này thành .env và điều chỉnh các giá trị

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL host (localhost cho local, RDS endpoint cho AWS)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gateway_db

# Database credentials (ĐỔITHÀNH GIÁ TRỊ CÓ THỰC)
DB_USER=postgres
DB_PASSWORD=change_me_to_secure_password_123!@#

# PostgreSQL version
POSTGRES_VERSION=15

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# Django JWT Secret Key (Tạo bằng: python -c 'import secrets; print(secrets.token_urlsafe(32))')
JWT_SECRET=change_me_to_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXP_DELTA_SECONDS=3600

# Django settings
DEBUG=False
DJANGO_LOG_LEVEL=INFO
ALLOWED_HOSTS=*
SECRET_KEY=change-me-to-secure-key-in-production-use-python-secrets-token_urlsafe

# ============================================
# MICROSERVICES URLS
# ============================================

# Service URLs for inter-service communication (internal Docker network)
BOOK_SERVICE_URL=http://book-service:8000
CART_SERVICE_URL=http://cart-service:8000
CATALOG_SERVICE_URL=http://catalog-service:8000
INVENTORY_SERVICE_URL=http://inventory-service:8000
ORDER_SERVICE_URL=http://order-service:8000
CUSTOMER_SERVICE_URL=http://customer-service:8000
PAYMENT_SERVICE_URL=http://pay-service:8000
SHIPPING_SERVICE_URL=http://ship-service:8000

# ============================================
# MESSAGE BROKER (RabbitMQ)
# ============================================

# RabbitMQ connection
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# RabbitMQ Management UI (chỉ dev, vô hiệu hóa production)
RABBITMQ_MGMT_PORT=15672

# ============================================
# CACHE & QUEUE (Redis)
# ============================================

# Redis connection (cho Celery & caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery settings
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================

# SMTP Server để gửi email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@bookstore.com

# ============================================
# AWS CONFIGURATION (Nếu dùng AWS)
# ============================================

# AWS Credentials
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=bookstore-assets

# S3 for static files (optional)
USE_S3=False
S3_BUCKET_STATIC=bookstore-static
S3_BUCKET_MEDIA=bookstore-media

# ============================================
# LOGGING & MONITORING
# ============================================

# CloudWatch (cho AWS)
CLOUDWATCH_LOG_GROUP=/bookstore/api-gateway
CLOUDWATCH_REGION=us-east-1

# Application Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# IMAGE PROCESSING
# ============================================

# Image upload settings
MAX_IMAGE_SIZE_MB=10
ALLOW_IMAGE_FORMATS=jpg,jpeg,png,webp,gif
IMAGE_THUMBNAIL_SIZE=300x300

# Image service worker settings
IMAGE_WORKER_PROCESSES=4
IMAGE_WORKER_TIMEOUT=300

# ============================================
# API SETTINGS
# ============================================

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
CORS_ALLOW_CREDENTIALS=True

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# ============================================
# PAYMENT & SHIPPING (3rd party integrations)
# ============================================

# Payment gateway (nếu có)
PAYMENT_GATEWAY_URL=https://api.payment-provider.com
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_SECRET=your-payment-secret

# Shipping provider (nếu có)
SHIPPING_API_URL=https://api.shipping-provider.com
SHIPPING_API_KEY=your-shipping-api-key

# ============================================
# AI & RECOMMENDATIONS
# ============================================

# Recommender service settings
AI_MODEL_PATH=/app/models/recommendation_model.pkl
MIN_CONFIDENCE_SCORE=0.7
RECOMMENDATION_COUNT=10

# ============================================
# DEVELOPMENT SETTINGS (Chỉ dùng cho local)
# ============================================

# Django debug toolbar (local only)
DEBUG_TOOLBAR_ENABLED=False

# Test database
TEST_DB_NAME=test_gateway_db

# Mock external services (testing)
MOCK_PAYMENT_SERVICE=False
MOCK_SHIPPING_SERVICE=False

# ============================================
# PRODUCTION SETTINGS
# ============================================

# Sentry (Error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Health check settings
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60

# ============================================
# DOCKER COMPOSE SPECIFIC
# ============================================

# Compose project name
COMPOSE_PROJECT_NAME=bookstore

# Restart policy
RESTART_POLICY=unless-stopped

# ============================================
# NOTES
# ============================================

# Thay đổi các giá trị này dựa trên environment:
# - LOCAL: Debug=True, localhost URLs
# - STAGING: Debug=False, staging domain
# - PRODUCTION: Debug=False, SSL enabled, secure credentials

# Không commit file .env này vào git!
# Thêm vào .gitignore: .env, .env.local, .env.*.local
